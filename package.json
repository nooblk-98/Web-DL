{
  "name": "website-downloader",
  "version": "1.0.0",
  "description": "Download the complete source code and assets of any website for offline viewing.",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "NODE_ENV=development node ./bin/www",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.19.2",
    "hbs": "~4.2.0",
    "http-errors": "~1.6.3",
    "ipaddr.js": "^2.2.0",
    "morgan": "~1.9.1",
    "socket.io": "^2.5.0",
    "socket.io-client": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2"
  }
}
