# Dependencies — reinstalled cleanly inside the image
node_modules
npm-debug.log*

# Runtime working area & generated artifacts (mounted as volumes instead)
downloads
public/sites/*.zip

# Version control & CI
.git
.gitignore
.github

# Local tooling / editor / agent settings
.claude
.vscode
.prettierrc
.prettierignore
eslint.config.js

# Tests & coverage (not needed at runtime)
__tests__
coverage

# Environment & logs
.env
.env.*
*.log
logs

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
